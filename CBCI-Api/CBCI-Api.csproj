<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <DebugType>embedded</DebugType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PackageId>Omega3065.ComponentBasedCustomItemAPI</PackageId>
    <Version>0.2.1.0</Version>
    <Authors>OMEGA3065</Authors>
    <IsPackable>true</IsPackable>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/OMEGA3065/CBCI-API/</RepositoryUrl>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <RootNamespace>CustomItemLib</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Northwood.SCPSL" Publicize="true" Private="false" Pack="false" />
    <Reference Include="CommandSystem.Core" Private="false" Pack="false" />
    <Reference Include="RaCustomMenu" Private="false" Pack="false" />
    <Reference Include="DigitalDust" Private="false" Pack="false" />
    <Reference Include="UnityEngine.CoreModule" Private="false" Pack="false" />
    <Reference Include="Mirror" Private="false" Pack="false" />
    <Reference Include="Mono.Security" Private="false" Pack="false" />
    <Reference Include="UnityEngine.PhysicsModule" Private="false" Pack="false" />
    <Reference Include="UnityEngine.UIElementsModule" Private="false" Pack="false" />
    <Reference Include="UnityEngine.TextRenderingModule" Private="false" Pack="false" />
    <Reference Include="NorthwoodLib" Private="false" Pack="false" />
    <Reference Include="ProjectMER" Private="false" Pack="false" />

    <None Include="..\LICENSE" Pack="true" PackagePath="" />
    <None Include="..\README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsRaCustomMenuBuild)'=='false'">
    <Compile Remove="Compat\RaCustomMenuCompat.cs" />
    <Compile Remove="Compat\RaCustomMenuCompatability\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Northwood.LabAPI" Version="1.1.7" />
    <PackageReference Include="Lib.Harmony" Version="2.2.2" />
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.2" PrivateAssets="all" />
    <PackageReference Include="RueI" Version="3.2.0" />
  </ItemGroup>
</Project>
